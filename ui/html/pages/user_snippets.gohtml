{{- /*gotype: github.com/Jackob2004/snippetbox/cmd/web.templateData*/ -}}
{{define "title"}}Your Snippets{{end}}

{{define "main"}}
    <h2>Your Snippets</h2>
    {{if .Snippets}}
        <table>
            <tr>
                <th>Title</th>
                <th>Created</th>
                <th>ID</th>
            </tr>
        {{range .Snippets}}
            <tr>
                <td><a href="/snippet/view/{{.ID}}">{{.Title}}</a></td>
                <td>{{humanDate .Created}}</td>
                <td>#{{.ID}}</td>
            </tr>
        {{end}}
        </table>
    {{else}}
        <p>You didn't create any snippets...</p>
    {{end}}
{{end}}