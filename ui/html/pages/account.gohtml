{{- /*gotype: github.com/Jackob2004/snippetbox/cmd/web.templateData*/ -}}
{{define "title"}}Your Account{{end}}

{{define "main"}}
    <h2>Your Account</h2>
        {{with .User}}
            <table>
                <tr>
                    <td><strong>Name</strong></td>
                    <td>{{.Name}}</td>
                </tr>
                <tr>
                    <td><strong>Email</strong></td>
                    <td>{{.Email}}</td>
                </tr>
                <tr>
                    <td><strong>Joined</strong></td>
                    <td>{{humanDate .CreatedAt}}</td>
                </tr>
            </table>
        {{end}}
{{end}}